# Machine-specific configuration (journal paths) — start from ed_outrider.toml.example
ed_outrider.toml
ed_outrider.toml.bak

# Your own data: the database built from your journals, browser_defaults.json, the lines you banned
# (speech_banned.json), backups/ (database + journals), downloaded Piper voices (piper-voices/), and what
# --restore moved aside (*.pre-restore-*, *.restore-*.part)
/data/

# restore leftovers beside a database kept outside data/ (--db, or db in the config)
*.pre-restore-*
*.restore-*.part

__pycache__/
*.pyc

# Node modules if you install jsdom for tests/page_smoke.js
node_modules/
package-lock.json

# Half-written rules download
resources/bio_rules.json.tmp
# ExploData's colour tables: downloaded on the first start, never shipped
resources/bio_colours.json
resources/bio_colours.json.tmp

# private planning notes, never committed
project/
# the EDDN listener (a developer's tool: watches EDDN's relay for what Outrider sends), its environment and its data
eddn_listener/

# Python virtual environment
.venv/

# Local install and launch scripts
scripts/install.sh
run.sh

# Docker: your own files beside the compose file
docker/data/*
!docker/data/.gitkeep
docker/config/*
!docker/config/.gitkeep
docker/journals/*
!docker/journals/.gitkeep
.env
# release bundles (scripts/docker_bundle.sh)
/dist/
